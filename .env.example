# HN Medical System — environment template
# Copy to `.env` for local development. Never commit a populated `.env`.
# In production these are set in Coolify (see DEPLOYMENT.md); a production
# server refuses to start if a required one is missing or unsafe.

# --- Application -------------------------------------------------------------
# Public base URL: the bare origin, https:// in production, no trailing path.
# Used for canonical URLs, the sitemap, metadata and links in emails.
APP_URL="http://localhost:3000"

# --- Database ----------------------------------------------------------------
# PostgreSQL connection string. Migrations are applied with
# `prisma migrate deploy` (the container does this at start-up).
DATABASE_URL="postgresql://hnmedical:CHANGE_ME@127.0.0.1:5432/hnmedical?schema=public"

# Only for docker-compose.yml, which runs its own PostgreSQL and builds
# DATABASE_URL from these. Use a long random password.
# POSTGRES_DB="hnmedical"
# POSTGRES_USER="hnmedical"
# POSTGRES_PASSWORD="CHANGE_ME"

# --- Authentication ----------------------------------------------------------
# Signing key for session tokens and two-factor secrets; at least 32
# characters. Generate with: openssl rand -base64 32
# Changing this signs every staff member out and invalidates enrolled
# authenticator apps.
AUTH_SECRET="CHANGE_ME"

# Required when running behind a reverse proxy (Coolify, nginx) so Auth.js
# trusts the forwarded host header.
AUTH_TRUST_HOST="true"

# Optional: set only if the deployment cannot infer its own URL.
# AUTH_URL="https://example.com"

# --- Persistent storage ------------------------------------------------------
# Media uploads. MUST be an absolute path on a volume mounted into the
# container — anything written inside the image is lost on the next deploy.
UPLOAD_ROOT="/data/hnmedical/uploads"

# Backup archives. Kept outside the web root and never served directly.
BACKUP_ROOT="/data/hnmedical/backups"

# --- Proxies -----------------------------------------------------------------
# How many reverse proxies sit in front of the app; the visitor's address is
# read from that many entries from the end of X-Forwarded-For, so it cannot be
# spoofed. 1 for Coolify alone (default), 2 with Cloudflare in front of it.
# TRUSTED_PROXY_HOPS="1"

# --- Container ---------------------------------------------------------------
# Set to 1 to stop the container applying migrations at start-up.
# SKIP_MIGRATIONS="1"
