# HN Medical System — environment template
# Copy to `.env` for local development. Never commit a populated `.env`.
#
# This file grows as phases land. Variables introduced so far:

# --- Application -------------------------------------------------------------
# Public base URL. Used for metadataBase, canonical URLs and sitemaps.
APP_URL="http://localhost:3000"

# --- Database ----------------------------------------------------------------
# PostgreSQL connection string. In production this is supplied by Coolify and
# must never be committed. Migrations are applied with `prisma migrate deploy`.
DATABASE_URL="postgresql://hnmedical:CHANGE_ME@127.0.0.1:5432/hnmedical?schema=public"

# --- Authentication ----------------------------------------------------------
# Signing key for session tokens. Generate with: openssl rand -base64 32
# Changing this signs every staff member out immediately.
AUTH_SECRET="CHANGE_ME"

# Required when running behind a reverse proxy (Coolify, nginx) so Auth.js
# trusts the forwarded host header.
AUTH_TRUST_HOST="true"

# Optional: set only if the deployment cannot infer its own URL.
# AUTH_URL="https://example.com"

# --- Persistent storage (Phases 7 and 47) ------------------------------------
# Must point at persistent volumes on the VPS, never the container filesystem.
# UPLOAD_ROOT="/data/hnmedical/uploads"
# BACKUP_ROOT="/data/hnmedical/backups"
