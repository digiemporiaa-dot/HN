# HN Medical System — environment template
# Copy to `.env` for local development. Never commit a populated `.env`.
#
# This file grows as phases land. Variables introduced so far:

# --- Application -------------------------------------------------------------
# Public base URL. Used for metadataBase, canonical URLs and sitemaps.
APP_URL="http://localhost:3000"

# --- Database (Phase 2) ------------------------------------------------------
# DATABASE_URL="postgresql://user:password@localhost:5432/hnmedical?schema=public"

# --- Authentication (Phase 3) ------------------------------------------------
# Generate with: openssl rand -base64 32
# AUTH_SECRET=""
# AUTH_URL="http://localhost:3000"

# --- Persistent storage (Phases 7 and 47) ------------------------------------
# Must point at persistent volumes on the VPS, never the container filesystem.
# UPLOAD_ROOT="/data/hnmedical/uploads"
# BACKUP_ROOT="/data/hnmedical/backups"
