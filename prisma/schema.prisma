// HN Medical System — database schema
//
// Conventions applied throughout:
//   * cuid primary keys
//   * createdAt / updatedAt on every mutable entity
//   * status enums rather than booleans wherever a lifecycle exists
//   * soft deletion only where accidental loss is expensive and restore is a
//     real requirement — everywhere else rows are deleted outright, to avoid
//     paying a filtering tax on every query
//   * JSON only where the data is genuinely polymorphic (section payloads,
//     audit metadata); everything else is normalised with foreign keys
//
// Entities for the catalogue, CRM, locations, forms and blog are introduced by
// the phases that build those features, so their columns can be designed
// against real requirements rather than guessed at here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7 takes the connection URL from prisma.config.ts for migrations, and
// from the driver adapter passed to PrismaClient at runtime.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum StaffStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

/// Shared publishing lifecycle. Programmatic SEO pages depend on DRAFT and
/// REVIEW existing as distinct states from PUBLISHED.
enum ContentStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum PermissionModule {
  DASHBOARD
  LEADS
  RFQ
  PRODUCTS
  CATEGORIES
  BRANDS
  SPECIALTIES
  SOLUTIONS
  LOCATIONS
  PAGES
  BLOGS
  NAVIGATION
  MEDIA
  FORMS
  SEO
  STAFF
  ROLES
  BACKUPS
  AUDIT_LOGS
  SETTINGS
}

enum PermissionAction {
  VIEW
  CREATE
  EDIT
  DELETE
  PUBLISH
  EXPORT
  ASSIGN
  RESTORE
  MANAGE_SETTINGS
}

/// Per-staff adjustments layered on top of the role's permission set.
enum PermissionEffect {
  GRANT
  REVOKE
}

enum MediaKind {
  IMAGE
  VECTOR
  DOCUMENT
}

enum SettingType {
  STRING
  TEXT
  NUMBER
  BOOLEAN
  JSON
  MEDIA
  COLOR
}

enum SectionType {
  HERO
  HEADING_TEXT
  RICH_TEXT
  IMAGE_TEXT
  TEXT_IMAGE
  ICON_CARDS
  IMAGE_CARDS
  FEATURE_CARDS
  PRODUCT_GRID
  CATEGORY_GRID
  SUBCATEGORY_GRID
  BRAND_GRID
  SPECIALTY_GRID
  STATISTICS
  LOGO_STRIP
  TESTIMONIALS
  FAQ
  CTA
  FORM
  TABLE
  COMPARISON_TABLE
  GALLERY
  VIDEO
  BROCHURE_DOWNLOAD
  RELATED_PRODUCTS
  RELATED_CATEGORIES
  RELATED_LOCATIONS
  TRUST_CERTIFICATIONS
  TIMELINE
  PROCESS_STEPS
  TABS
  ACCORDION
}

// ---------------------------------------------------------------------------
// Identity and access control
// ---------------------------------------------------------------------------

model Staff {
  id                 String      @id @default(cuid())
  email              String      @unique
  name               String
  phone              String?
  passwordHash       String
  status             StaffStatus @default(ACTIVE)
  mustChangePassword Boolean     @default(false)

  /// Incremented to invalidate every issued JWT at once — on password change,
  /// deactivation or role change. Compared in the session callback.
  tokenVersion Int       @default(0)
  lastLoginAt  DateTime?

  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  avatarId String?
  avatar   MediaAsset? @relation("StaffAvatar", fields: [avatarId], references: [id], onDelete: SetNull)

  permissionOverrides StaffPermissionOverride[]
  auditLogs           AuditLog[]
  uploadedMedia       MediaAsset[]              @relation("MediaUploader")
  twoFactorSecret     TwoFactorSecret?
  recoveryCodes       RecoveryCode[]
  sessions            StaffSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
  @@index([status])
  @@index([createdAt])
}

model Role {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String?

  /// System roles cannot be renamed away or deleted; SUPER_ADMIN additionally
  /// short-circuits every permission check.
  isSystem Boolean @default(false)

  staff       Staff[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  module      PermissionModule
  action      PermissionAction
  description String?

  roles     RolePermission[]
  overrides StaffPermissionOverride[]

  createdAt DateTime @default(now())

  @@unique([module, action])
  @@index([module])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model StaffPermissionOverride {
  staffId      String
  permissionId String
  effect       PermissionEffect

  staff      Staff      @relation(fields: [staffId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([staffId, permissionId])
  @@index([permissionId])
}

/// Standards-based TOTP (RFC 6238), so any authenticator app works — Microsoft
/// Authenticator, Google Authenticator, 1Password and the rest.
///
/// The shared secret is stored encrypted, never in plaintext, and is only ever
/// decrypted to verify a code. A row with confirmedAt still null is an
/// enrolment that was started but never proved, and does not gate sign-in.
model TwoFactorSecret {
  id      String @id @default(cuid())
  staffId String @unique
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  secretCiphertext String
  confirmedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Single-use fallback codes for a lost authenticator.
///
/// Hashed with SHA-256 rather than bcrypt: the codes are generated with high
/// entropy, so a slow hash buys nothing, and an indexed digest lets one code be
/// matched with a single lookup instead of comparing against every stored hash.
model RecoveryCode {
  id      String @id @default(cuid())
  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  codeHash String
  usedAt   DateTime?

  createdAt DateTime @default(now())

  @@unique([staffId, codeHash])
  @@index([staffId])
}

/// One row per sign-in, so a staff member can see where they are signed in and
/// end a single session without dropping every other device.
///
/// Credentials sign-in requires JWT sessions, which carry no server-side state
/// of their own; this table supplies it. The session id travels in the token
/// and is checked against this table on every protected request.
model StaffSession {
  id      String @id @default(cuid())
  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  ipAddress String?
  userAgent String?

  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  createdAt DateTime @default(now())

  @@index([staffId])
  @@index([revokedAt])
  @@index([createdAt])
}

/// Login throttling. Deliberately has no foreign key to Staff: attempts are
/// recorded for addresses that do not exist too, otherwise the table itself
/// would reveal which emails are real.
model LoginAttempt {
  id         String  @id @default(cuid())
  email      String
  ipAddress  String?
  userAgent  String?
  successful Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

/// Append-only by convention: rows are never updated or deleted, which is why
/// there is no updatedAt. The actor relation is nullable and accompanied by an
/// email snapshot so history survives staff deletion.
model AuditLog {
  id String @id @default(cuid())

  actorId    String?
  actor      Staff?  @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String?

  action     String
  module     PermissionModule?
  entityType String?
  entityId   String?
  summary    String?

  /// Sanitised before write. Secrets, password hashes, tokens and recovery
  /// codes must never reach this column.
  metadata Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([module])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Settings
// ---------------------------------------------------------------------------

/// Typed key/value store for global site settings. `value` holds scalars as
/// text and is parsed according to `type`; `jsonValue` is used only by JSON
/// settings, which keeps the common case out of a JSON column.
model Setting {
  id          String      @id @default(cuid())
  key         String      @unique
  group       String
  type        SettingType
  label       String
  description String?
  value       String?
  jsonValue   Json?

  /// Secret settings are never serialised to the client.
  isSecret Boolean @default(false)
  order    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group])
}

// ---------------------------------------------------------------------------
// Media
// ---------------------------------------------------------------------------

model MediaFolder {
  id       String  @id @default(cuid())
  name     String
  slug     String
  parentId String?

  parent   MediaFolder?  @relation("MediaFolderTree", fields: [parentId], references: [id], onDelete: Restrict)
  children MediaFolder[] @relation("MediaFolderTree")

  /// Materialised path ("/products/2026/01") so a subtree can be listed
  /// without a recursive query.
  path  String @unique
  depth Int    @default(0)

  assets MediaAsset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([parentId, slug])
  @@index([parentId])
}

model MediaAsset {
  id String @id @default(cuid())

  folderId String?
  folder   MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  /// Path relative to UPLOAD_ROOT. Generated, never derived from the uploaded
  /// filename, which neutralises filename-based attacks and collisions.
  storageKey   String    @unique
  originalName String
  mimeType     String
  kind         MediaKind
  sizeBytes    Int
  width        Int?
  height       Int?
  checksum     String?

  altText     String?
  title       String?
  caption     String?
  description String?

  uploadedById String?
  uploadedBy   Staff?  @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  usages               MediaUsage[]
  staffAvatar          Staff[]          @relation("StaffAvatar")
  navigationItems      NavigationItem[] @relation("NavigationItemImage")
  categoryImages       Category[]       @relation("CategoryImage")
  categoryBanners      Category[]       @relation("CategoryBanner")
  brandLogos           Brand[]          @relation("BrandLogo")
  brandBanners         Brand[]          @relation("BrandBanner")
  specialtyImages      Specialty[]      @relation("SpecialtyImage")
  specialtyBanners     Specialty[]      @relation("SpecialtyBanner")
  solutionImages       Solution[]       @relation("SolutionImage")
  solutionBanners      Solution[]       @relation("SolutionBanner")
  productPrimaryImages Product[]        @relation("ProductPrimaryImage")
  productGalleryImages ProductImage[]   @relation("ProductGalleryImage")

  /// Soft deleted: recovering a wrongly deleted asset that is still referenced
  /// by published content is a genuine requirement.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([folderId])
  @@index([kind])
  @@index([uploadedById])
  @@index([deletedAt])
  @@index([createdAt])
}

/// Reference tracking that powers the "this file is in use" warning before
/// deletion. Rows are written by the services that attach media, not by hand.
model MediaUsage {
  id      String     @id @default(cuid())
  assetId String
  asset   MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  entityType String
  entityId   String
  field      String

  createdAt DateTime @default(now())

  @@unique([assetId, entityType, entityId, field])
  @@index([entityType, entityId])
  @@index([assetId])
}

// ---------------------------------------------------------------------------
// CMS
// ---------------------------------------------------------------------------

/// The homepage is the page with the reserved slug "home", so administrators
/// can reorder its sections like any other page.
model Page {
  id     String        @id @default(cuid())
  slug   String        @unique
  title  String
  status ContentStatus @default(DRAFT)

  publishedAt DateTime?

  sections PageSection[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status])
  @@index([publishedAt])
  @@index([deletedAt])
}

/// `content` and `design` are the only JSON columns in the content model. Each
/// is validated against a per-section-type Zod schema in the section registry,
/// and `design` accepts only enumerated token values — never raw CSS.
///
/// Sections become attachable to categories, brands, specialties, solutions and
/// location pages in the phases that introduce those entities; pageId becomes
/// nullable alongside sibling foreign keys at that point.
model PageSection {
  id     String @id @default(cuid())
  pageId String
  page   Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  type     SectionType
  order    Int
  enabled  Boolean     @default(true)
  anchorId String?

  content Json
  design  Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId, order])
  @@index([type])
}

/// Where a menu renders. One menu per location today; the enum rather than a
/// boolean leaves room for a second header variant without a migration.
enum NavigationLocation {
  HEADER
  FOOTER
  LEGAL
}

model NavigationMenu {
  id String @id @default(cuid())

  /// Stable programmatic handle. The renderer asks for a menu by key, so a menu
  /// can be renamed in the admin without breaking the layout that draws it.
  key      String             @unique
  name     String
  location NavigationLocation

  description String?

  /// System menus are seeded and cannot be deleted: the public layout expects
  /// them to exist, and an empty menu is recoverable while a missing one is not.
  isSystem Boolean @default(true)

  items NavigationItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([location])
}

/// One entry in a menu tree.
///
/// Depth is capped at two by the editor (top level, column, link) because that
/// is what a mega menu can present legibly; the column is stored as a normal
/// item with children rather than as a separate model, so reordering and
/// visibility work identically at every level.
model NavigationItem {
  id String @id @default(cuid())

  menuId String
  menu   NavigationMenu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  parentId String?
  parent   NavigationItem?  @relation("NavigationItemChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children NavigationItem[] @relation("NavigationItemChildren")

  label       String
  /// Optional: a mega-menu column heading is a label with no destination of
  /// its own. Validated against the same scheme allowlist as CMS links.
  href        String?
  description String?

  order Int
  depth Int @default(0)

  visible      Boolean @default(true)
  openInNewTab Boolean @default(false)
  /// Renders as a button rather than a link — for a single call to action.
  highlight    Boolean @default(false)

  imageId String?
  image   MediaAsset? @relation("NavigationItemImage", fields: [imageId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([menuId, parentId, order])
  @@index([parentId])
  @@index([imageId])
}

/// A catalogue category or subcategory.
///
/// One model with a self-relation rather than two tables: a subcategory needs
/// exactly what a category needs — its own slug, image, status, products and
/// eventually SEO — and two near-identical tables would duplicate every query,
/// every form and every SEO code path. The admin presents them as separate
/// screens over this one model.
model Category {
  id String @id @default(cuid())

  slug String
  name String

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")

  /// 0 for a category, 1 for a subcategory. Stored rather than derived so list
  /// screens can filter by level without walking the tree.
  depth Int @default(0)
  order Int @default(0)

  shortDescription String?
  description      String?

  imageId String?
  image   MediaAsset? @relation("CategoryImage", fields: [imageId], references: [id], onDelete: SetNull)

  bannerId String?
  banner   MediaAsset? @relation("CategoryBanner", fields: [bannerId], references: [id], onDelete: SetNull)

  /// Surfaced in category grids on the homepage and in the mega menu.
  featured Boolean @default(false)

  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?

  /// Soft deleted: a category carries products, URLs and inbound links, so
  /// deleting one by mistake is expensive and restoring it is a real need.
  deletedAt DateTime?

  brands      BrandCategory[]
  specialties CategorySpecialty[]
  solutions   SolutionCategory[]
  products    Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([parentId, slug])
  @@index([parentId, order])
  @@index([status])
  @@index([depth])
  @@index([deletedAt])
  @@index([featured])
  @@index([imageId])
  @@index([bannerId])
}

/// A manufacturer whose equipment the company supplies.
///
/// Not soft-deleted: unlike a category or product, a brand carries no content
/// of its own that would be unrecoverable, and the plan confines soft deletion
/// to the entities where restore is a genuine requirement.
model Brand {
  id String @id @default(cuid())

  /// Brands live at /brands/<slug>, a single segment, so the slug is unique
  /// across the whole table rather than within a parent.
  slug String @unique
  name String

  shortDescription String?
  description      String?

  /// The manufacturer's own site. Stored so a brand page can credit the source
  /// rather than implying the equipment is made in-house.
  websiteUrl String?

  logoId String?
  logo   MediaAsset? @relation("BrandLogo", fields: [logoId], references: [id], onDelete: SetNull)

  bannerId String?
  banner   MediaAsset? @relation("BrandBanner", fields: [bannerId], references: [id], onDelete: SetNull)

  /// Surfaced in brand strips on the homepage and category pages.
  featured Boolean @default(false)
  order    Int     @default(0)

  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?

  categories BrandCategory[]
  products   Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([featured])
  @@index([order])
  @@index([logoId])
  @@index([bannerId])
}

/// Which categories a brand supplies equipment for.
///
/// An explicit join rather than an implicit many-to-many, so the pairing can
/// carry its own ordering later without a migration that rewrites the table.
model BrandCategory {
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt     DateTime     @default(now())

  @@id([brandId, categoryId])
  @@index([categoryId])
}

/// A clinical department or discipline the company equips — ICU, operating
/// theatre, cardiology.
///
/// Distinct from a category: a category is what the equipment *is*, a specialty
/// is who uses it. The same ventilator belongs to one category but serves
/// several specialties, which is why the link is a join rather than a column.
model Specialty {
  id String @id @default(cuid())

  /// Specialties live at /specialties/<slug>, a single segment.
  slug String @unique
  name String

  shortDescription String?
  description      String?

  imageId String?
  image   MediaAsset? @relation("SpecialtyImage", fields: [imageId], references: [id], onDelete: SetNull)

  bannerId String?
  banner   MediaAsset? @relation("SpecialtyBanner", fields: [bannerId], references: [id], onDelete: SetNull)

  featured Boolean @default(false)
  order    Int     @default(0)

  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?

  categories CategorySpecialty[]
  products   ProductSpecialty[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([featured])
  @@index([order])
  @@index([imageId])
  @@index([bannerId])
}

/// Which categories of equipment a specialty uses.
model CategorySpecialty {
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  specialtyId String
  specialty   Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  createdAt     DateTime     @default(now())

  @@id([categoryId, specialtyId])
  @@index([specialtyId])
}

/// A packaged offering the company sells — ICU setup, a turnkey theatre, a
/// hospital fit-out.
///
/// Structurally identical to Specialty but a different axis of the catalogue:
/// a specialty is a department that uses equipment, a solution is a bundle the
/// company delivers. Keeping them as separate models rather than one table with
/// a "kind" column means each can grow its own fields — a solution will
/// eventually carry scope and delivery detail a specialty never needs.
model Solution {
  id String @id @default(cuid())

  /// Solutions live at /solutions/<slug>, a single segment.
  slug String @unique
  name String

  shortDescription String?
  description      String?

  imageId String?
  image   MediaAsset? @relation("SolutionImage", fields: [imageId], references: [id], onDelete: SetNull)

  bannerId String?
  banner   MediaAsset? @relation("SolutionBanner", fields: [bannerId], references: [id], onDelete: SetNull)

  featured Boolean @default(false)
  order    Int     @default(0)

  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?

  categories SolutionCategory[]
  products   ProductSolution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([featured])
  @@index([order])
  @@index([imageId])
  @@index([bannerId])
}

/// Which categories of equipment a solution includes.
model SolutionCategory {
  solutionId String
  solution   Solution @relation(fields: [solutionId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt     DateTime     @default(now())

  @@id([solutionId, categoryId])
  @@index([categoryId])
}

/// A piece of equipment the company supplies.
///
/// Deliberately has no price. The business runs on quotations, so a number
/// here would be a number somebody eventually shows a customer — and medical
/// equipment pricing is negotiated per order, per configuration and per
/// institution. Enquiries carry the commercial conversation instead.
model Product {
  id String @id @default(cuid())

  /// Products live at /products/<slug>, a single segment.
  slug String @unique
  name String

  /// The manufacturer's model or catalogue number, as printed on the device.
  modelNumber String?

  shortDescription String?
  description      String?

  /// A product sits in exactly one category: that is what decides its URL in
  /// the catalogue and which specification template applies. Breadth comes
  /// from the specialty and solution links instead.
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  /// Restrict rather than SetNull: silently stripping the manufacturer from a
  /// catalogue of medical equipment is not something an administrator deleting
  /// a brand would expect.
  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: Restrict)

  primaryImageId String?
  primaryImage   MediaAsset? @relation("ProductPrimaryImage", fields: [primaryImageId], references: [id], onDelete: SetNull)

  images      ProductImage[]
  specialties ProductSpecialty[]
  solutions   ProductSolution[]

  featured Boolean @default(false)
  order    Int     @default(0)

  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?

  /// Soft deleted: a product carries a URL, inbound links and enquiry history,
  /// so deleting one by mistake is expensive and restoring it is a real need.
  deletedAt DateTime?

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([deletedAt])
  @@index([featured])
  @@index([publishedAt])
  @@index([primaryImageId])
}

/// A product's gallery, ordered.
model ProductImage {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  mediaId String
  media   MediaAsset @relation("ProductGalleryImage", fields: [mediaId], references: [id], onDelete: Cascade)

  order Int @default(0)

  createdAt DateTime @default(now())

  /// The same picture twice in one gallery is always a mistake.
  @@unique([productId, mediaId])
  @@index([productId, order])
}

/// Which clinical departments use a product.
model ProductSpecialty {
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  specialtyId String
  specialty   Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@id([productId, specialtyId])
  @@index([specialtyId])
}

/// Which packaged offerings include a product.
model ProductSolution {
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  solutionId String
  solution   Solution @relation(fields: [solutionId], references: [id], onDelete: Cascade)

  @@id([productId, solutionId])
  @@index([solutionId])
}
