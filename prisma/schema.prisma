// HN Medical System — database schema
//
// Conventions applied throughout:
//   * cuid primary keys
//   * createdAt / updatedAt on every mutable entity
//   * status enums rather than booleans wherever a lifecycle exists
//   * soft deletion only where accidental loss is expensive and restore is a
//     real requirement — everywhere else rows are deleted outright, to avoid
//     paying a filtering tax on every query
//   * JSON only where the data is genuinely polymorphic (section payloads,
//     audit metadata); everything else is normalised with foreign keys
//
// Entities for the catalogue, CRM, locations, forms and blog are introduced by
// the phases that build those features, so their columns can be designed
// against real requirements rather than guessed at here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7 takes the connection URL from prisma.config.ts for migrations, and
// from the driver adapter passed to PrismaClient at runtime.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum StaffStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

/// Shared publishing lifecycle. Programmatic SEO pages depend on DRAFT and
/// REVIEW existing as distinct states from PUBLISHED.
enum ContentStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum PermissionModule {
  DASHBOARD
  LEADS
  RFQ
  PRODUCTS
  CATEGORIES
  BRANDS
  SPECIALTIES
  SOLUTIONS
  APPLICATIONS
  LOCATIONS
  PAGES
  BLOGS
  NAVIGATION
  MEDIA
  FORMS
  SEO
  STAFF
  ROLES
  BACKUPS
  AUDIT_LOGS
  SETTINGS
}

enum PermissionAction {
  VIEW
  CREATE
  EDIT
  DELETE
  PUBLISH
  EXPORT
  ASSIGN
  RESTORE
  MANAGE_SETTINGS
}

/// Per-staff adjustments layered on top of the role's permission set.
enum PermissionEffect {
  GRANT
  REVOKE
}

enum MediaKind {
  IMAGE
  VECTOR
  DOCUMENT
}

enum SettingType {
  STRING
  TEXT
  NUMBER
  BOOLEAN
  JSON
  MEDIA
  COLOR
}

enum SectionType {
  HERO
  HEADING_TEXT
  RICH_TEXT
  IMAGE_TEXT
  TEXT_IMAGE
  ICON_CARDS
  IMAGE_CARDS
  FEATURE_CARDS
  PRODUCT_GRID
  CATEGORY_GRID
  SUBCATEGORY_GRID
  BRAND_GRID
  SPECIALTY_GRID
  STATISTICS
  LOGO_STRIP
  TESTIMONIALS
  FAQ
  CTA
  FORM
  TABLE
  COMPARISON_TABLE
  GALLERY
  VIDEO
  BROCHURE_DOWNLOAD
  RELATED_PRODUCTS
  RELATED_CATEGORIES
  RELATED_LOCATIONS
  TRUST_CERTIFICATIONS
  TIMELINE
  PROCESS_STEPS
  TABS
  ACCORDION
}

// ---------------------------------------------------------------------------
// Identity and access control
// ---------------------------------------------------------------------------

model Staff {
  id                 String      @id @default(cuid())
  email              String      @unique
  name               String
  phone              String?
  passwordHash       String
  status             StaffStatus @default(ACTIVE)
  mustChangePassword Boolean     @default(false)

  /// Incremented to invalidate every issued JWT at once — on password change,
  /// deactivation or role change. Compared in the session callback.
  tokenVersion Int       @default(0)
  lastLoginAt  DateTime?

  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  avatarId String?
  avatar   MediaAsset? @relation("StaffAvatar", fields: [avatarId], references: [id], onDelete: SetNull)

  permissionOverrides StaffPermissionOverride[]
  auditLogs           AuditLog[]
  assignedLeads       Lead[]                    @relation("LeadOwner")
  leadNotes           LeadNote[]                @relation("LeadNoteAuthor")
  leadActivities      LeadActivity[]            @relation("LeadActivityActor")
  uploadedMedia       MediaAsset[]              @relation("MediaUploader")
  twoFactorSecret     TwoFactorSecret?
  recoveryCodes       RecoveryCode[]
  sessions            StaffSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
  @@index([status])
  @@index([createdAt])
}

model Role {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String?

  /// System roles cannot be renamed away or deleted; SUPER_ADMIN additionally
  /// short-circuits every permission check.
  isSystem Boolean @default(false)

  staff       Staff[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  module      PermissionModule
  action      PermissionAction
  description String?

  roles     RolePermission[]
  overrides StaffPermissionOverride[]

  createdAt DateTime @default(now())

  @@unique([module, action])
  @@index([module])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model StaffPermissionOverride {
  staffId      String
  permissionId String
  effect       PermissionEffect

  staff      Staff      @relation(fields: [staffId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([staffId, permissionId])
  @@index([permissionId])
}

/// Standards-based TOTP (RFC 6238), so any authenticator app works — Microsoft
/// Authenticator, Google Authenticator, 1Password and the rest.
///
/// The shared secret is stored encrypted, never in plaintext, and is only ever
/// decrypted to verify a code. A row with confirmedAt still null is an
/// enrolment that was started but never proved, and does not gate sign-in.
model TwoFactorSecret {
  id      String @id @default(cuid())
  staffId String @unique
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  secretCiphertext String
  confirmedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Single-use fallback codes for a lost authenticator.
///
/// Hashed with SHA-256 rather than bcrypt: the codes are generated with high
/// entropy, so a slow hash buys nothing, and an indexed digest lets one code be
/// matched with a single lookup instead of comparing against every stored hash.
model RecoveryCode {
  id      String @id @default(cuid())
  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  codeHash String
  usedAt   DateTime?

  createdAt DateTime @default(now())

  @@unique([staffId, codeHash])
  @@index([staffId])
}

/// One row per sign-in, so a staff member can see where they are signed in and
/// end a single session without dropping every other device.
///
/// Credentials sign-in requires JWT sessions, which carry no server-side state
/// of their own; this table supplies it. The session id travels in the token
/// and is checked against this table on every protected request.
model StaffSession {
  id      String @id @default(cuid())
  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  ipAddress String?
  userAgent String?

  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  createdAt DateTime @default(now())

  @@index([staffId])
  @@index([revokedAt])
  @@index([createdAt])
}

/// Login throttling. Deliberately has no foreign key to Staff: attempts are
/// recorded for addresses that do not exist too, otherwise the table itself
/// would reveal which emails are real.
model LoginAttempt {
  id         String  @id @default(cuid())
  email      String
  ipAddress  String?
  userAgent  String?
  successful Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

/// Append-only by convention: rows are never updated or deleted, which is why
/// there is no updatedAt. The actor relation is nullable and accompanied by an
/// email snapshot so history survives staff deletion.
model AuditLog {
  id String @id @default(cuid())

  actorId    String?
  actor      Staff?  @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String?

  action     String
  module     PermissionModule?
  entityType String?
  entityId   String?
  summary    String?

  /// Sanitised before write. Secrets, password hashes, tokens and recovery
  /// codes must never reach this column.
  metadata Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([module])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Settings
// ---------------------------------------------------------------------------

/// Typed key/value store for global site settings. `value` holds scalars as
/// text and is parsed according to `type`; `jsonValue` is used only by JSON
/// settings, which keeps the common case out of a JSON column.
model Setting {
  id          String      @id @default(cuid())
  key         String      @unique
  group       String
  type        SettingType
  label       String
  description String?
  value       String?
  jsonValue   Json?

  /// Secret settings are never serialised to the client.
  isSecret Boolean @default(false)
  order    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group])
}

// ---------------------------------------------------------------------------
// Media
// ---------------------------------------------------------------------------

model MediaFolder {
  id       String  @id @default(cuid())
  name     String
  slug     String
  parentId String?

  parent   MediaFolder?  @relation("MediaFolderTree", fields: [parentId], references: [id], onDelete: Restrict)
  children MediaFolder[] @relation("MediaFolderTree")

  /// Materialised path ("/products/2026/01") so a subtree can be listed
  /// without a recursive query.
  path  String @unique
  depth Int    @default(0)

  assets MediaAsset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([parentId, slug])
  @@index([parentId])
}

model MediaAsset {
  id String @id @default(cuid())

  folderId String?
  folder   MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  /// Path relative to UPLOAD_ROOT. Generated, never derived from the uploaded
  /// filename, which neutralises filename-based attacks and collisions.
  storageKey   String    @unique
  originalName String
  mimeType     String
  kind         MediaKind
  sizeBytes    Int
  width        Int?
  height       Int?
  checksum     String?

  altText     String?
  title       String?
  caption     String?
  description String?

  uploadedById String?
  uploadedBy   Staff?  @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  usages               MediaUsage[]
  staffAvatar          Staff[]          @relation("StaffAvatar")
  navigationItems      NavigationItem[] @relation("NavigationItemImage")
  categoryImages       Category[]       @relation("CategoryImage")
  categoryBanners      Category[]       @relation("CategoryBanner")
  brandLogos           Brand[]          @relation("BrandLogo")
  brandBanners         Brand[]          @relation("BrandBanner")
  specialtyImages      Specialty[]      @relation("SpecialtyImage")
  specialtyBanners     Specialty[]      @relation("SpecialtyBanner")
  solutionImages       Solution[]       @relation("SolutionImage")
  solutionBanners      Solution[]       @relation("SolutionBanner")
  productPrimaryImages Product[]        @relation("ProductPrimaryImage")
  productGalleryImages ProductImage[]   @relation("ProductGalleryImage")
  productDocuments     ProductDocument[] @relation("ProductDocumentFile")

  /// Soft deleted: recovering a wrongly deleted asset that is still referenced
  /// by published content is a genuine requirement.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([folderId])
  @@index([kind])
  @@index([uploadedById])
  @@index([deletedAt])
  @@index([createdAt])
}

/// Reference tracking that powers the "this file is in use" warning before
/// deletion. Rows are written by the services that attach media, not by hand.
model MediaUsage {
  id      String     @id @default(cuid())
  assetId String
  asset   MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  entityType String
  entityId   String
  field      String

  createdAt DateTime @default(now())

  @@unique([assetId, entityType, entityId, field])
  @@index([entityType, entityId])
  @@index([assetId])
}

// ---------------------------------------------------------------------------
// CMS
// ---------------------------------------------------------------------------

/// The homepage is the page with the reserved slug "home", so administrators
/// can reorder its sections like any other page.
model Page {
  id     String        @id @default(cuid())
  slug   String        @unique
  title  String
  status ContentStatus @default(DRAFT)

  publishedAt DateTime?

  sections PageSection[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status])
  @@index([publishedAt])
  @@index([deletedAt])
}

/// `content` and `design` are the only JSON columns in the content model. Each
/// is validated against a per-section-type Zod schema in the section registry,
/// and `design` accepts only enumerated token values — never raw CSS.
///
/// Sections become attachable to categories, brands, specialties, solutions and
/// location pages in the phases that introduce those entities; pageId becomes
/// nullable alongside sibling foreign keys at that point.
model PageSection {
  id     String @id @default(cuid())
  pageId String
  page   Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  type     SectionType
  order    Int
  enabled  Boolean     @default(true)
  anchorId String?

  content Json
  design  Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId, order])
  @@index([type])
}

/// Where a menu renders. One menu per location today; the enum rather than a
/// boolean leaves room for a second header variant without a migration.
enum NavigationLocation {
  HEADER
  FOOTER
  LEGAL
}

model NavigationMenu {
  id String @id @default(cuid())

  /// Stable programmatic handle. The renderer asks for a menu by key, so a menu
  /// can be renamed in the admin without breaking the layout that draws it.
  key      String             @unique
  name     String
  location NavigationLocation

  description String?

  /// System menus are seeded and cannot be deleted: the public layout expects
  /// them to exist, and an empty menu is recoverable while a missing one is not.
  isSystem Boolean @default(true)

  items NavigationItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([location])
}

/// One entry in a menu tree.
///
/// Depth is capped at two by the editor (top level, column, link) because that
/// is what a mega menu can present legibly; the column is stored as a normal
/// item with children rather than as a separate model, so reordering and
/// visibility work identically at every level.
model NavigationItem {
  id String @id @default(cuid())

  menuId String
  menu   NavigationMenu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  parentId String?
  parent   NavigationItem?  @relation("NavigationItemChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children NavigationItem[] @relation("NavigationItemChildren")

  label       String
  /// Optional: a mega-menu column heading is a label with no destination of
  /// its own. Validated against the same scheme allowlist as CMS links.
  href        String?
  description String?

  order Int
  depth Int @default(0)

  visible      Boolean @default(true)
  openInNewTab Boolean @default(false)
  /// Renders as a button rather than a link — for a single call to action.
  highlight    Boolean @default(false)

  imageId String?
  image   MediaAsset? @relation("NavigationItemImage", fields: [imageId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([menuId, parentId, order])
  @@index([parentId])
  @@index([imageId])
}

/// A catalogue category or subcategory.
///
/// One model with a self-relation rather than two tables: a subcategory needs
/// exactly what a category needs — its own slug, image, status, products and
/// eventually SEO — and two near-identical tables would duplicate every query,
/// every form and every SEO code path. The admin presents them as separate
/// screens over this one model.
model Category {
  id String @id @default(cuid())

  slug String
  name String

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")

  /// 0 for a category, 1 for a subcategory. Stored rather than derived so list
  /// screens can filter by level without walking the tree.
  depth Int @default(0)
  order Int @default(0)

  shortDescription String?
  description      String?

  /// What a procurement officer needs before raising a tender: installation,
  /// warranty, service cover, what a quotation for this range normally
  /// includes. Separate from the description because it answers a different
  /// question — "what is this" against "how do we buy it".
  procurementInfo String?

  imageId String?
  image   MediaAsset? @relation("CategoryImage", fields: [imageId], references: [id], onDelete: SetNull)

  bannerId String?
  banner   MediaAsset? @relation("CategoryBanner", fields: [bannerId], references: [id], onDelete: SetNull)

  /// Surfaced in category grids on the homepage and in the mega menu.
  featured Boolean @default(false)

  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?

  /// Soft deleted: a category carries products, URLs and inbound links, so
  /// deleting one by mistake is expensive and restoring it is a real need.
  deletedAt DateTime?

  brands      BrandCategory[]
  specialties CategorySpecialty[]
  solutions   SolutionCategory[]
  products    Product[]
  leads       Lead[]

  specTemplate SpecTemplate?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([parentId, slug])
  @@index([parentId, order])
  @@index([status])
  @@index([depth])
  @@index([deletedAt])
  @@index([featured])
  @@index([imageId])
  @@index([bannerId])
}

/// A manufacturer whose equipment the company supplies.
///
/// Not soft-deleted: unlike a category or product, a brand carries no content
/// of its own that would be unrecoverable, and the plan confines soft deletion
/// to the entities where restore is a genuine requirement.
model Brand {
  id String @id @default(cuid())

  /// Brands live at /brands/<slug>, a single segment, so the slug is unique
  /// across the whole table rather than within a parent.
  slug String @unique
  name String

  shortDescription String?
  description      String?

  /// The manufacturer's own site. Stored so a brand page can credit the source
  /// rather than implying the equipment is made in-house.
  websiteUrl String?

  logoId String?
  logo   MediaAsset? @relation("BrandLogo", fields: [logoId], references: [id], onDelete: SetNull)

  bannerId String?
  banner   MediaAsset? @relation("BrandBanner", fields: [bannerId], references: [id], onDelete: SetNull)

  /// Surfaced in brand strips on the homepage and category pages.
  featured Boolean @default(false)
  order    Int     @default(0)

  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?

  categories BrandCategory[]
  products   Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([featured])
  @@index([order])
  @@index([logoId])
  @@index([bannerId])
}

/// Which categories a brand supplies equipment for.
///
/// An explicit join rather than an implicit many-to-many, so the pairing can
/// carry its own ordering later without a migration that rewrites the table.
model BrandCategory {
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt     DateTime     @default(now())

  @@id([brandId, categoryId])
  @@index([categoryId])
}

/// A clinical department or discipline the company equips — ICU, operating
/// theatre, cardiology.
///
/// Distinct from a category: a category is what the equipment *is*, a specialty
/// is who uses it. The same ventilator belongs to one category but serves
/// several specialties, which is why the link is a join rather than a column.
model Specialty {
  id String @id @default(cuid())

  /// Specialties live at /specialties/<slug>, a single segment.
  slug String @unique
  name String

  shortDescription String?
  description      String?

  imageId String?
  image   MediaAsset? @relation("SpecialtyImage", fields: [imageId], references: [id], onDelete: SetNull)

  bannerId String?
  banner   MediaAsset? @relation("SpecialtyBanner", fields: [bannerId], references: [id], onDelete: SetNull)

  featured Boolean @default(false)
  order    Int     @default(0)

  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?

  categories CategorySpecialty[]
  products   ProductSpecialty[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([featured])
  @@index([order])
  @@index([imageId])
  @@index([bannerId])
}

/// Which categories of equipment a specialty uses.
model CategorySpecialty {
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  specialtyId String
  specialty   Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  createdAt     DateTime     @default(now())

  @@id([categoryId, specialtyId])
  @@index([specialtyId])
}

/// A packaged offering the company sells — ICU setup, a turnkey theatre, a
/// hospital fit-out.
///
/// Structurally identical to Specialty but a different axis of the catalogue:
/// a specialty is a department that uses equipment, a solution is a bundle the
/// company delivers. Keeping them as separate models rather than one table with
/// a "kind" column means each can grow its own fields — a solution will
/// eventually carry scope and delivery detail a specialty never needs.
model Solution {
  id String @id @default(cuid())

  /// Solutions live at /solutions/<slug>, a single segment.
  slug String @unique
  name String

  shortDescription String?
  description      String?

  imageId String?
  image   MediaAsset? @relation("SolutionImage", fields: [imageId], references: [id], onDelete: SetNull)

  bannerId String?
  banner   MediaAsset? @relation("SolutionBanner", fields: [bannerId], references: [id], onDelete: SetNull)

  featured Boolean @default(false)
  order    Int     @default(0)

  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?

  categories SolutionCategory[]
  products   ProductSolution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([featured])
  @@index([order])
  @@index([imageId])
  @@index([bannerId])
}

/// Which categories of equipment a solution includes.
model SolutionCategory {
  solutionId String
  solution   Solution @relation(fields: [solutionId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt     DateTime     @default(now())

  @@id([solutionId, categoryId])
  @@index([categoryId])
}

/// A piece of equipment the company supplies.
///
/// Deliberately has no price. The business runs on quotations, so a number
/// here would be a number somebody eventually shows a customer — and medical
/// equipment pricing is negotiated per order, per configuration and per
/// institution. Enquiries carry the commercial conversation instead.
model Product {
  id String @id @default(cuid())

  /// Products live at /products/<slug>, a single segment.
  slug String @unique
  name String

  /// The manufacturer's model or catalogue number, as printed on the device.
  modelNumber String?

  shortDescription String?
  description      String?

  /// A product sits in exactly one category: that is what decides its URL in
  /// the catalogue and which specification template applies. Breadth comes
  /// from the specialty and solution links instead.
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  /// Restrict rather than SetNull: silently stripping the manufacturer from a
  /// catalogue of medical equipment is not something an administrator deleting
  /// a brand would expect.
  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: Restrict)

  primaryImageId String?
  primaryImage   MediaAsset? @relation("ProductPrimaryImage", fields: [primaryImageId], references: [id], onDelete: SetNull)

  images      ProductImage[]
  specialties ProductSpecialty[]
  solutions   ProductSolution[]

  specGroups   ProductSpecGroup[]
  documents    ProductDocument[]
  applications ProductApplication[]
  points       ProductPoint[]
  leads        Lead[]
  rfqItems     RfqItem[]

  /// Two sides of one table: what this product points at, and what points at
  /// it. The second exists so deleting a product can clear the links naming it.
  relatedFrom ProductRelated[] @relation("ProductRelatedFrom")
  relatedTo   ProductRelated[] @relation("ProductRelatedTo")

  featured Boolean @default(false)
  order    Int     @default(0)

  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?

  /// Soft deleted: a product carries a URL, inbound links and enquiry history,
  /// so deleting one by mistake is expensive and restoring it is a real need.
  deletedAt DateTime?

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([deletedAt])
  @@index([featured])
  @@index([publishedAt])
  @@index([primaryImageId])
}

/// A product's gallery, ordered.
model ProductImage {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  mediaId String
  media   MediaAsset @relation("ProductGalleryImage", fields: [mediaId], references: [id], onDelete: Cascade)

  order Int @default(0)

  createdAt DateTime @default(now())

  /// The same picture twice in one gallery is always a mistake.
  @@unique([productId, mediaId])
  @@index([productId, order])
}

/// Which clinical departments use a product.
model ProductSpecialty {
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  specialtyId String
  specialty   Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@id([productId, specialtyId])
  @@index([specialtyId])
}

/// Which packaged offerings include a product.
model ProductSolution {
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  solutionId String
  solution   Solution @relation(fields: [solutionId], references: [id], onDelete: Cascade)

  @@id([productId, solutionId])
  @@index([solutionId])
}

// ---------------------------------------------------------------------------
// Product information
// ---------------------------------------------------------------------------

/// What a document is, which decides how the product page labels and groups it.
enum DocumentKind {
  BROCHURE
  DATASHEET
  MANUAL
  CERTIFICATE
  CASE_STUDY
  OTHER
}

/// The specification fields a category's products are expected to fill in.
///
/// A template exists so two ventilators can be compared line by line instead of
/// each carrying whatever the person entering it happened to think of. It is
/// applied to a product on request and copied, never linked: once a product has
/// its own specifications, editing the template must not silently rewrite what
/// is already published.
model SpecTemplate {
  id   String @id @default(cuid())
  name String

  /// One per category. The template only makes products comparable if there is
  /// a single answer to "what fields does this category use".
  categoryId String   @unique
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  groups SpecTemplateGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SpecTemplateGroup {
  id String @id @default(cuid())

  templateId String
  template   SpecTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  label String
  order Int    @default(0)

  fields SpecTemplateField[]

  @@index([templateId, order])
}

model SpecTemplateField {
  id String @id @default(cuid())

  groupId String
  group   SpecTemplateGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  label String

  /// "mm", "kg", "L/min" — kept apart from the value so a specification table
  /// can align units in their own column.
  unit  String?
  order Int     @default(0)

  @@index([groupId, order])
}

/// A product's own specifications, grouped as they are displayed.
model ProductSpecGroup {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  label String
  order Int    @default(0)

  items ProductSpecItem[]

  @@index([productId, order])
}

model ProductSpecItem {
  id String @id @default(cuid())

  groupId String
  group   ProductSpecGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  label String
  value String
  unit  String?
  order Int     @default(0)

  @@index([groupId, order])
}

/// A downloadable file attached to a product.
/// What kind of selling point a line is.
///
/// Both are short lists an administrator writes by hand, and they are kept in
/// one table because they differ only in where they appear: a highlight is a
/// phrase beside the picture, a feature is a claim with a sentence under it.
enum ProductPointKind {
  HIGHLIGHT
  FEATURE
}

/// One highlight or feature on a product page.
///
/// Deliberately not derived from the specification table. A specification is a
/// measurement; a highlight is a decision about which measurement matters to a
/// buyer, and that is editorial work the specification rows cannot do.
model ProductPoint {
  id        String       @id @default(cuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  kind ProductPointKind

  title String
  /// The sentence under a feature. Highlights are the title alone.
  body  String?

  order Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, kind, order])
}

model ProductDocument {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  mediaId String
  media   MediaAsset @relation("ProductDocumentFile", fields: [mediaId], references: [id], onDelete: Cascade)

  /// The label shown to a visitor, which is rarely the uploaded filename.
  title String
  kind  DocumentKind @default(BROCHURE)

  /// Whether the file is released only after an enquiry. Stored here so the
  /// decision lives with the document; the gate itself is enforced by the
  /// download route once the lead capture exists.
  gated Boolean @default(false)

  grants DocumentGrant[]

  order Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, mediaId])
  @@index([productId, order])
  @@index([mediaId])
}

/// What a product is used for.
///
/// A third axis, distinct from the other two: a specialty is the department
/// that owns the equipment, a solution is the package the company delivers, and
/// an application is the procedure the device is bought to perform.
model Application {
  id   String @id @default(cuid())
  slug String @unique
  name String

  description String?
  order       Int     @default(0)

  products ProductApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model ProductApplication {
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@id([productId, applicationId])
  @@index([applicationId])
}

/// Products an editor has chosen to show alongside another.
///
/// Deliberately one-directional: "buy this cart with this monitor" does not
/// imply the reverse, and an automatic back-link would fill accessory pages
/// with every machine that happens to use them.
model ProductRelated {
  productId String
  product   Product @relation("ProductRelatedFrom", fields: [productId], references: [id], onDelete: Cascade)

  relatedId String
  related   Product @relation("ProductRelatedTo", fields: [relatedId], references: [id], onDelete: Cascade)

  order Int @default(0)

  @@id([productId, relatedId])
  @@index([relatedId])
}

/// A question and answer attached to any record that can carry one.
///
/// Polymorphic in the same way MediaUsage is: FAQs hang off products now and
/// off categories, solutions and pages later, and a foreign key per owner would
/// mean a migration every time another screen wants them. The cost is the same
/// one MediaUsage pays — no referential integrity — so rows are cleared
/// explicitly when their owner is deleted.
model Faq {
  id String @id @default(cuid())

  entityType String
  entityId   String

  question String
  answer   String
  order    Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entityType, entityId, order])
}

// ---------------------------------------------------------------------------
// Enquiries
// ---------------------------------------------------------------------------

/// Where an enquiry came from. Kept as an enum rather than free text because
/// every report anyone will ever ask for starts by grouping on it.
/// What a form field collects, which decides how it renders, how it is
/// validated and how an answer is read back.
/// Which part of a lead a form field answers.
///
/// Chosen by the administrator rather than guessed from the label: a form with
/// two email fields, or one whose "Name" question is the machine's name and not
/// the person's, is ordinary, and guessing wrong files an enquiry under the
/// wrong customer.
enum FormFieldMapping {
  NONE
  NAME
  EMAIL
  PHONE
  ORGANISATION
  CITY
  MESSAGE
}

enum FormFieldType {
  TEXT
  EMAIL
  PHONE
  NUMBER
  TEXTAREA
  SELECT
  CHECKBOX
  RADIO
  FILE
  DATE
}

/// A form an administrator builds rather than a developer writes.
///
/// Deliberately separate from the enquiry form, which is fixed on purpose: the
/// enquiry form is the one path we tune and never break, and a form somebody
/// assembles for a trade show should not be able to change it.
model Form {
  id String @id @default(cuid())

  /// How a page refers to this form. Stable across renames, which is what
  /// stops an edited title breaking every page the form is embedded on.
  key  String @unique
  name String

  /// Shown above the fields, for context the fields cannot carry themselves.
  description String?

  /// What a visitor is told once it has been sent.
  successMessage String?
  /// The button. Blank means the default.
  submitLabel    String?

  /// Where a notification goes. Blank falls back to the site's enquiry
  /// recipients, so a form is never silently received by nobody.
  notifyEmail String?

  /// A draft form does not render, and its endpoint refuses submissions: a
  /// form taken down should stop collecting, not merely stop being linked.
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?

  fields      FormField[]
  submissions FormSubmission[]

  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([deletedAt])
}

/// One question on a form.
model FormField {
  id     String @id @default(cuid())
  formId String
  form   Form   @relation(fields: [formId], references: [id], onDelete: Cascade)

  type FormFieldType

  /// What an answer is filed under. Derived from the label when a field is
  /// created and then left alone, so renaming a question does not orphan every
  /// answer already collected under the old name.
  key String

  label       String
  placeholder String?
  help        String?

  required Boolean @default(false)

  /// A hidden field is not rendered and its answer is not accepted. Kept
  /// rather than deleted so the answers already given to it survive.
  hidden Boolean @default(false)

  /// Choices for SELECT and RADIO, one per line. Ignored by every other type.
  options String?

  /// What this question contributes to a lead. A form with no EMAIL mapping
  /// produces submissions and no lead, which is the right answer for a survey.
  mapsTo FormFieldMapping @default(NONE)

  order Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([formId, key])
  @@index([formId, order])
}

/// One completed form.
///
/// The answers are stored as JSON keyed by field key rather than as a row per
/// answer. A submission is a record of what was said on the day: it is read as
/// a whole, never queried field by field, and freezing it means a later edit to
/// the form cannot rewrite what somebody already sent.
model FormSubmission {
  id     String @id @default(cuid())
  formId String
  form   Form   @relation(fields: [formId], references: [id], onDelete: Cascade)

  /// { fieldKey: string | string[] }, with a file answer holding its media id.
  answers Json

  /// Files attached to this submission, so deleting it takes them with it.
  files FormSubmissionFile[]

  /// The lead this produced, when the form maps a field to an email address.
  lead Lead?

  /// Kept for abuse handling only, and never exported.
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([formId, createdAt])
}

/// A file a visitor attached.
///
/// A row of its own rather than a MediaAsset: the media library is the
/// administrators' own, and a stranger's upload appearing in the picker
/// alongside the brand logos is not something anyone asked for.
model FormSubmissionFile {
  id           String         @id @default(cuid())
  submissionId String
  submission   FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  /// Which question it answers.
  fieldKey String

  storageKey   String @unique
  originalName String
  mimeType     String
  sizeBytes    Int

  createdAt DateTime @default(now())

  @@index([submissionId])
}

/// Where an enquiry came from.
///
/// Derived from what a submission actually carries rather than declared by it,
/// so a source is a fact about the enquiry rather than a claim the form made.
enum LeadSource {
  PRODUCT_ENQUIRY
  CATEGORY_ENQUIRY
  DOCUMENT_DOWNLOAD
  CONTACT_FORM
  CUSTOM_FORM
  CITY_LANDING
  RFQ
  /// Reserved. A click on a WhatsApp link is not an enquiry anybody consented
  /// to have recorded, so nothing writes this yet; it exists so the pipeline
  /// can hold one when a conversation there turns into a lead.
  WHATSAPP
}

/// The stages a lead moves through.
///
/// Order is defined in the application rather than taken from this enum: a
/// stage added later would otherwise land in the wrong place in the pipeline.
enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  QUOTATION_SENT
  NEGOTIATION
  WON
  LOST
}

/// How urgently a lead needs working. Set by the sales team, never by a visitor.
enum LeadPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// What kind of thing happened to a lead.
enum LeadActivityKind {
  CREATED
  STAGE_CHANGED
  PRIORITY_CHANGED
  ASSIGNED
  NOTE_ADDED
  DOCUMENT_DOWNLOADED
}

/// Someone who got in touch.
model Lead {
  id String @id @default(cuid())

  /// Human-readable and quoted in correspondence: HN-2026-0001.
  reference String @unique

  name         String
  email        String
  phone        String?
  organisation String?
  city         String?

  message String?

  source LeadSource
  status LeadStatus @default(NEW)

  /// The product asked about, kept as a link and as a name.
  ///
  /// The link is for reporting; the name is what the enquiry actually said. A
  /// product can be renamed or withdrawn afterwards, and an enquiry is a record
  /// of a conversation, not a live view of the catalogue.
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String?

  /// The category asked about, on the same terms as the product: a link for
  /// reporting and a name for the record.
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryName String?

  /// The page the enquiry was sent from, as a path. Which page produced a lead
  /// is the first question asked of any campaign, and it cannot be recovered
  /// afterwards.
  landingPage String?

  /// The campaign parameters as they were on that page. Recorded verbatim and
  /// truncated; they are read by people, never matched against anything.
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?

  priority LeadPriority @default(NORMAL)

  /// Set when a built form produced this lead, so the answers to its own
  /// questions can be read alongside it.
  formSubmissionId String?         @unique
  formSubmission   FormSubmission? @relation(fields: [formSubmissionId], references: [id], onDelete: SetNull)

  assignedToId String?
  assignedTo   Staff?  @relation("LeadOwner", fields: [assignedToId], references: [id], onDelete: SetNull)

  /// What was agreed to and when, stored as the wording shown at the time.
  /// Consent that cannot be evidenced is not consent.
  consentedAt DateTime?
  consentText String?

  /// Kept only so abuse can be investigated. Never shown in the interface and
  /// never exported.
  ipAddress String?
  userAgent String?

  notes      LeadNote[]
  activities LeadActivity[]
  grants     DocumentGrant[]
  items      RfqItem[]

  /// Soft deleted: an enquiry is a commercial record, and deleting one by
  /// mistake loses a conversation nobody can reconstruct.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([source, createdAt])
  @@index([assignedToId])
  @@index([email])
  @@index([productId])
  @@index([categoryId])
  @@index([priority, createdAt])
  @@index([deletedAt])
  @@index([createdAt])
}

/// One thing that happened to a lead, in the order it happened.
///
/// Append-only and never edited. A stage moved back and forth three times is a
/// fact about how the deal went, and a history that can be tidied is not a
/// history. Notes stay in their own table because they are written prose; this
/// records that one was added.
model LeadActivity {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  kind LeadActivityKind

  /// Who did it. Null for anything the visitor themselves caused.
  actorId   String?
  actor     Staff?  @relation("LeadActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  /// Kept as text so the entry still reads correctly after an account is gone.
  actorName String?

  /// One line, already written for a reader.
  summary String

  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

/// One line of a quotation request.
///
/// A hospital's tender covers a list, not a machine, so an enquiry can carry
/// several products with a quantity and a note against each.
model RfqItem {
  id String @id @default(cuid())

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  /// The product as a link and as text, for the same reason the lead itself
  /// keeps both: the link is for reporting, the text is what was asked for.
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  productName String
  modelNumber String?

  quantity Int     @default(1)
  notes    String?
  order    Int     @default(0)

  createdAt DateTime @default(now())

  @@index([leadId, order])
  @@index([productId])
}

model LeadNote {
  id String @id @default(cuid())

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  authorId String?
  author   Staff?  @relation("LeadNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  /// Who wrote it, kept as text so a note still reads correctly after the
  /// author's account is removed.
  authorName String

  body String

  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

/// Permission for one enquirer to download one gated document.
///
/// The token is the whole of the authorisation, so it is long, random and
/// expiring. Gated files are never reachable through the ordinary media route;
/// this row is the only way to one.
model DocumentGrant {
  id    String @id @default(cuid())
  token String @unique

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  documentId String
  document   ProductDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  expiresAt        DateTime
  downloadCount    Int       @default(0)
  lastDownloadedAt DateTime?

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([documentId])
  @@index([expiresAt])
}

/// A record of every message the system tried to send.
///
/// Mail fails quietly by nature — a wrong password, a blocked port, a
/// greylisting relay — and a notification nobody received looks exactly like
/// one nobody sent. This makes the difference visible without opening a log.
model MailDelivery {
  id String @id @default(cuid())

  /// What the message was about, e.g. "lead.notification".
  kind String

  /// Recipients as sent, comma separated. Always addresses an administrator
  /// configured, never anything a visitor typed.
  recipients String
  subject    String

  status   MailStatus @default(PENDING)
  attempts Int        @default(0)

  /// The transport's own words, trimmed. Useful for "relay refused" and no use
  /// at all for anything else, so it is never shown to a visitor.
  error String?

  /// What the message was about, when there is a record to point at.
  entityType String?
  entityId   String?

  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([kind, createdAt])
  @@index([entityType, entityId])
}

enum MailStatus {
  PENDING
  SENT
  FAILED
  /// No transport is configured, so nothing was attempted.
  SKIPPED
}
