# Never sent to the Docker daemon: secrets, local state, build output and
# anything the image rebuilds itself.
.env
.env.*
!.env.example
.git
.gitignore
node_modules
.next
out
coverage
tsconfig.tsbuildinfo
npm-debug.log*
*.pem
# Local uploads or backups must never be baked into an image.
uploads
backups
data
# Temporary fixture scripts used while developing.
scripts/*.tmp.ts
